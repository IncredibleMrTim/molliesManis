# SMTP credentials for the mailbox the contact form sends through.
SMTP_HOST=smtp.livemail.co.uk
SMTP_PORT=465
# "true" for port 465 (implicit TLS), "false" for 587/25 (STARTTLS).
SMTP_SECURE=true
SMTP_USER=hello@molliesmanis.co.uk
SMTP_PASS=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=hello@molliesmanis.co.uk
